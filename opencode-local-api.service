[Unit]
Description=Minimal OpenCode local API relay
After=network-online.target

[Service]
Type=exec
EnvironmentFile=@ENVIRONMENT@
Environment=@ENVELOPE@
UMask=0077
ExecStart=@NODE@ @SERVER@
ExecStartPost=@NODE@ @SERVER@ --check
Restart=on-failure
RestartSec=5
TimeoutStartSec=90

[Install]
WantedBy=default.target
